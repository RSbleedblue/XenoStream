APP_NAME=xtts-fastapi
APP_ENV=prod
HOST=0.0.0.0
PORT=8000

# Set this in production to require x-api-key header.
API_KEY=change-me

# Keep request text size bounded.
MAX_TEXT_CHARS=800
STREAM_CHUNK_CHARS=160
MAX_CONCURRENT_REQUESTS=4
REQUEST_TIMEOUT_SECONDS=90

# XTTS model and runtime config.
MODEL_NAME=tts_models/multilingual/multi-dataset/xtts_v2
DEVICE=cpu
PRELOAD_MODEL=true
# Optional: one-time default reference voice file; then you can omit speaker_wav_path per request.
DEFAULT_SPEAKER_WAV_PATH=
COQUI_TOS_AGREED=0

OUTPUT_DIR=outputs
VOICES_DIR=voices
